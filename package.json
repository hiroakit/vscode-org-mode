{
    "name": "org-mode",
    "displayName": "Org Mode",
    "description": "Emacs Org mode support for VSCode",
    "keywords": [
        "org",
        "orgmode",
        "org-mode",
        "emacs"
    ],
    "version": "1.1.0-SNAPSHOT",
    "publisher": "vscode-org-mode",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/vscode-org-mode/vscode-org-mode"
    },
    "icon": "images/logo.png",
    "engines": {
        "vscode": "^1.87.0",
        "node": ">=18.20.4",
        "npm": ">=8"
    },
    "categories": [
        "Languages"
    ],
    "activationEvents": [
        "onLanguage:org"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "commands": [
            {
                "command": "org.insertHeadingRespectContent",
                "title": "Org: Insert Heading Respect Content"
            },
            {
                "command": "org.insertSubheading",
                "title": "Org: Insert Subheading"
            },
            {
                "command": "org.doDemote",
                "title": "Org: Do Demote"
            },
            {
                "command": "org.doPromote",
                "title": "Org: Do Promote"
            },
            {
                "command": "org.promoteSubtree",
                "title": "Org: Promote Subtree"
            },
            {
                "command": "org.demoteSubtree",
                "title": "Org: Demote Subtree"
            },
            {
                "command": "org.timestamp",
                "title": "Org: Timestamp"
            },
            {
                "command": "org.clockin",
                "title": "Org: Clock In"
            },
            {
                "command": "org.clockout",
                "title": "Org: Clock Out"
            },
            {
                "command": "org.updateclock",
                "title": "Org: Update Clock Total"
            },
            {
                "command": "org.incrementContext",
                "title": "Org: Increment Context"
            },
            {
                "command": "org.decrementContext",
                "title": "Org: Decrement Context"
            },
            {
                "command": "org.bold",
                "title": "Org: Bold"
            },
            {
                "command": "org.italic",
                "title": "Org: Italic"
            },
            {
                "command": "org.underline",
                "title": "Org: Underline"
            },
            {
                "command": "org.code",
                "title": "Org: Code"
            },
            {
                "command": "org.verbose",
                "title": "Org: Verbose"
            },
            {
                "command": "org.literal",
                "title": "Org: Literal"
            },
            {
                "command": "org.butterfly",
                "title": "Org: Butterfly"
            }
        ],
        "languages": [
            {
                "id": "org",
                "aliases": [
                    "Org",
                    "Org Markup",
                    "Org Mode"
                ],
                "extensions": [
                    ".org"
                ],
                "configuration": "./org.configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "org",
                "scopeName": "source.org",
                "path": "./syntaxes/org.tmLanguage.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Org Mode configuration",
            "properties": {
                "org.todoKeywords": {
                    "type": "array",
                    "default": [
                        "TODO",
                        "DONE"
                    ],
                    "description": "Specifies the types of TODO statuses available (for switching)."
                },
                "org.addLeftZero": {
                    "type": "boolean",
                    "default": false,
                    "description": "Add left zero to single-digit dates and months."
                },
                "org.clockInOutSeparator": {
                    "type": "string",
                    "default": "--",
                    "description": "Clock in and clock out separator"
                },
                "org.clockTotalSeparator": {
                    "type": "string",
                    "default": " =>  ",
                    "description": "Clock total separator"
                }
            }
        },
        "snippets": [
            {
                "language": "org",
                "path": "./snippets/org.json"
            }
        ],
        "keybindings": [
            {
                "command": "org.insertHeadingRespectContent",
                "key": "ctrl+alt+o h",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.insertSubheading",
                "key": "ctrl+alt+o s",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.doDemote",
                "key": "ctrl+alt+o shift+d",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.doPromote",
                "key": "ctrl+alt+o shift+p",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.promoteSubtree",
                "key": "ctrl+alt+o p",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.demoteSubtree",
                "key": "ctrl+alt+o d",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.timestamp",
                "key": "ctrl+alt+o t",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.clockin",
                "key": "ctrl+alt+o ctrl+i",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.clockout",
                "key": "ctrl+alt+o ctrl+o",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.updateclock",
                "key": "ctrl+alt+o ctrl+u",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.incrementContext",
                "key": "alt+right",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.decrementContext",
                "key": "alt+left",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.bold",
                "key": "ctrl+alt+o b",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.italic",
                "key": "ctrl+alt+o i",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.underline",
                "key": "ctrl+alt+o u",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.code",
                "key": "ctrl+alt+o c",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.verbose",
                "key": "ctrl+alt+o v",
                "when": "editorLangId == 'org'"
            },
            {
                "command": "org.literal",
                "key": "ctrl+alt+o l",
                "when": "editorLangId == 'org'"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "tsc -p ./",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext .ts",
        "fix": "eslint --fix src --ext .ts",
        "test": "npm run compile && node ./scripts/run-vscode-test.js",
        "test:coverage": "npm run compile && node ./scripts/run-vscode-test.js --coverage",
        "publish-coverage": "node ./scripts/upload-codecov.js",
        "generate-syntax": "node syntaxes/populate-syntax.js"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.11.30",
        "@types/vscode": "^1.87.0",
        "@typescript-eslint/eslint-plugin": "^7.4.0",
        "@typescript-eslint/parser": "^7.4.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.3.9",
        "eslint": "^8.57.0",
        "mocha": "^11.7.5",
        "typescript": "^5.4.3"
    },
    "dependencies": {
        "date-fns": "^1.28.3"
    },
    "overrides": {
        "brace-expansion@^1.0.0": "1.1.12",
        "brace-expansion@^2.0.0": "2.0.2",
        "cross-spawn": "^7.0.6",
        "diff": "8.0.3",
        "glob": "^10.5.0",
        "js-yaml": "4.1.1",
        "micromatch": "^4.0.8"
    }
}
